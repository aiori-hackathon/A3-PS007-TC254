# PRIV6GUARD Configuration Template
# NOTE: Placeholders only. Never commit real secrets or credentials.

# Application Server
APP_NAME=PRIV6GUARD
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Storage
DB_PATH=data/priv6guard.db

# Cryptographic Keys (Replace with strong random token in production)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY

# Configuration Paths
LAB_CONFIG_PATH=config/lab_config.yaml
DETECTION_RULES_PATH=config/detection_rules.yaml

# Privacy & Session Timing
SESSION_TTL_SECONDS=300
PSEUDONYM_EPOCH_SECONDS=120
PURGE_INTERVAL_SECONDS=30
